{
  "name": "over-party-lab-chatbot",
  "version": "1.0.0",
  "description": "A LINE chatbot built with Google Apps Script and TypeScript for Over Party Lab",
  "main": "main.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "push": "npm run build && clasp push",
    "deploy": "npm run build && clasp push && clasp deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sean1093/over-party-lab-chatbot.git"
  },
  "keywords": [
    "chatbot",
    "linebot",
    "line-messaging-api",
    "google-apps-script",
    "typescript",
    "cocktail",
    "clasp"
  ],
  "author": "Sean Chou",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sean1093/over-party-lab-chatbot/issues"
  },
  "homepage": "https://github.com/sean1093/over-party-lab-chatbot#readme",
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^1.0.83",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
